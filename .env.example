NEXT_PUBLIC_APP_URL=http://localhost:3000
# Category-specific links shown on each guest's RSVP page.
CEREMONY_RECEPTION_INFO_URL=https://www.google.com
RECEPTION_ONLY_INFO_URL=https://www.google.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Select one implementation: twilio or vonage
MESSAGING_PROVIDER=vonage

# Twilio implementation
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Preferred: a Messaging Service SID. Alternatively set TWILIO_SENDER_ID to
# an SMS-capable number or supported Alphanumeric Sender ID.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SENDER_ID=

# Vonage implementation
VONAGE_API_KEY=your-api-key
VONAGE_API_SECRET=your-api-secret
VONAGE_SENDER_ID=MYEVENT

ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-random-password
